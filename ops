{"author":{"id":"585844baa6074d44d241f46aa7c9f21ff46653adf617d7f070fbfe327626c989"},"ops":[{"type":1,"timestamp":1794735262,"nonce":"6Punc+/V/q94JoFMONSsqFgwW4M=","title":"hxn-gpu-webgl2: the WebGL2 fallback for browsers without WebGPU","message":"A driver library for the same wasm build as hxn-gpu-webgpu, used when `navigator.gpu` is missing. Shaders are hxnsl's GLSL ES 3.00 (`GLSL_VERTEX`, `GLSL_FRAGMENT`, bound by the names in `GLSL_BINDINGS`), the same path as hxn-gpu-gles. No compute and no storage buffers: hxnsl marks such shaders with `GLSL_MISSING`, and a program that needs them has no WebGL2 path.","files":null}]}