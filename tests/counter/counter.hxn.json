          "params": [{ "name": "other", "type": "Counter?" }],
          "returns": "Counter?",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "into_value",
          "docs": "Gives the counter up for its value.",
          "kind": "consuming",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "live",
          "docs": "How many counters exist.",
          "kind": "static",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "fail",
          "docs": "Panics, to show what a binding makes of that.",
          "kind": "static",
          "params": [],
          "returns": "void",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "nap",
