{
  "hxn": 1,
  "library": "counter",
  "interfaces": [
    {
      "name": "Counter",
      "docs": "A number that is added to, with one of each thing a binding carries.",
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [{ "name": "start", "type": "i32" }],
          "returns": "Counter",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "fill",
          "docs": "`count` bytes, each the value's low byte. Fails for a negative count.",
          "kind": "method",
          "params": [{ "name": "count", "type": "i32" }],
          "returns": "bytes",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "add",
          "docs": "Adds to the value and returns it. Fails if it would overflow. A\nlocked counter leaves the value as it is.",
          "kind": "mutating",
          "params": [{ "name": "amount", "type": "i32" }],
          "returns": "i32",
          "fallible": true,
          "blocking": false
