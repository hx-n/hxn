{
  "hxn": 1,
  "library": "counter",
  "interfaces": [
    {
      "name": "Counter",
      "docs": "A number that is added to, with one of each thing a binding carries.",
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [{ "name": "start", "type": "i32" }],
          "returns": "Counter",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "add",
          "docs": "Adds to the value and returns it. Fails if it would overflow. A\nlocked counter leaves the value as it is.",
          "kind": "mutating",
          "params": [{ "name": "amount", "type": "i32" }],
          "returns": "i32",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "adds",
          "docs": "How many adds have been made, as a cell the host reads directly.",
          "kind": "method",
          "params": [],
          "returns": "atomic_i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "locked",
          "docs": "Set to make the counter ignore adds.",
          "kind": "method",
          "params": [],
          "returns": "atomic_flag",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "work",
          "docs": "Does `units` of work, counting each in `progress`, and stops early\nonce `cancel` is set. Returns how many were done.",
          "kind": "method",
          "params": [{ "name": "units", "type": "i32" }, { "name": "progress", "type": "atomic_i32" }, { "name": "cancel", "type": "atomic_flag" }],
          "returns": "i32",
          "fallible": false,
          "blocking": true
        },
        {
          "name": "label",
          "kind": "method",
          "params": [{ "name": "name", "type": "str" }],
          "returns": "str",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "sum",
          "kind": "method",
          "params": [{ "name": "data", "type": "bytes" }],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "is_positive",
          "kind": "method",
          "params": [],
          "returns": "bool",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "scaled",
          "kind": "method",
          "params": [{ "name": "factor", "type": "f64" }],
          "returns": "f64",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "set",
          "docs": "Sets the value, or its negation.",
          "kind": "mutating",
          "params": [{ "name": "value", "type": "i32" }, { "name": "negate", "type": "bool" }],
          "returns": "void",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "absorb",
          "docs": "Adds another counter's value to this one.",
          "kind": "mutating",
          "params": [{ "name": "other", "type": "Counter" }],
          "returns": "i32",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "swap",
          "docs": "Exchanges values with another counter.",
          "kind": "mutating",
          "params": [{ "name": "other", "type": "Counter", "borrow": "exclusive" }],
          "returns": "void",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "fork",
          "docs": "A new counter starting at this one's value.",
          "kind": "method",
          "params": [],
          "returns": "Counter",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "larger",
          "docs": "A counter at the larger of the two values, or nothing without\nanother to compare with.",
          "kind": "method",
          "params": [{ "name": "other", "type": "Counter?" }],
          "returns": "Counter?",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "into_value",
          "docs": "Gives the counter up for its value.",
          "kind": "consuming",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "live",
          "docs": "How many counters exist.",
          "kind": "static",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "fail",
          "docs": "Panics, to show what a binding makes of that.",
          "kind": "static",
          "params": [],
          "returns": "void",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "nap",
          "docs": "Sleeps, as a call that waits on something would.",
          "kind": "static",
          "params": [{ "name": "milliseconds", "type": "i32" }],
          "returns": "void",
          "fallible": false,
          "blocking": true
        }
      ]
    },
    {
      "name": "Job",
      "docs": "Work on a thread of the library's own, watched and stopped through two\ncells.",
      "methods": [
        {
          "name": "new",
          "docs": "Starts counting to `units`, one a millisecond.",
          "kind": "constructor",
          "params": [{ "name": "units", "type": "i32" }],
          "returns": "Job",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "done",
          "kind": "method",
          "params": [],
          "returns": "atomic_i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "stop",
          "kind": "method",
          "params": [],
          "returns": "atomic_flag",
          "fallible": false,
          "blocking": false
        }
      ]
    },
    {
      "name": "Tally",
      "docs": "A running total of counters: one interface that takes and makes another.",
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [],
          "returns": "Tally",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "record",
          "docs": "Adds a counter's value to the total and returns it.",
          "kind": "mutating",
          "params": [{ "name": "counter", "type": "Counter" }],
          "returns": "i32",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "total",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "to_counter",
          "docs": "A counter starting at the total.",
          "kind": "method",
          "params": [],
          "returns": "Counter",
          "fallible": false,
          "blocking": false
        }
      ]
    },
    {
      "name": "Pot",
      "docs": "A total several things add to. Shared: the library and any number of\nHaxe objects hold the same one, and it lives while any of them does.",
      "shared": true,
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [{ "name": "start", "type": "i32" }],
          "returns": "Pot",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "add",
          "docs": "Adds to the total and returns it.",
          "kind": "method",
          "params": [{ "name": "amount", "type": "i32" }],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "total",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "split",
          "docs": "A pot of its own starting at this one's total, made already shared.",
          "kind": "method",
          "params": [],
          "returns": "Pot",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "live",
          "docs": "How many pots exist, however many hold each.",
          "kind": "static",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        }
      ]
    },
    {
      "name": "Player",
      "docs": "Something that pays into a pot it keeps a share of.",
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [{ "name": "pot", "type": "Pot" }],
          "returns": "Player",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "pay",
          "docs": "Adds to the pot and returns its total.",
          "kind": "method",
          "params": [{ "name": "amount", "type": "i32" }],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "pot",
          "docs": "The pot this pays into: the same one each time.",
          "kind": "method",
          "params": [],
          "returns": "Pot",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "pays_into",
          "docs": "Whether this pays into `pot`.",
          "kind": "method",
          "params": [{ "name": "pot", "type": "Pot" }],
          "returns": "bool",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "move_to",
          "docs": "Moves to another pot, or stays for none. Returns the one left behind.",
          "kind": "mutating",
          "params": [{ "name": "pot", "type": "Pot?" }],
          "returns": "Pot?",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "fuller",
          "docs": "The fuller of this player's pot and another, if there is another.",
          "kind": "method",
          "params": [{ "name": "other", "type": "Pot?" }],
          "returns": "Pot?",
          "fallible": false,
          "blocking": false
        }
      ]
    },
    {
      "name": "Blob",
      "docs": "Bytes the collector cannot see, which it is told of: to the host, one of\nthese is a few words whatever its size here.",
      "weighed": true,
      "methods": [
        {
          "name": "new",
          "kind": "constructor",
          "params": [{ "name": "size", "type": "i32" }],
          "returns": "Blob",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "size",
          "kind": "method",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "resize",
          "kind": "mutating",
          "params": [{ "name": "size", "type": "i32" }],
          "returns": "void",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "copy",
          "docs": "Another blob with the same bytes, as heavy as this one.",
          "kind": "method",
          "params": [],
          "returns": "Blob",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "live",
          "docs": "How many blobs exist.",
          "kind": "static",
          "params": [],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "crowded",
          "docs": "Asks the host to collect at its next chance.",
          "kind": "static",
          "params": [],
          "returns": "void",
          "fallible": false,
          "blocking": false
        }
      ]
    }
  ]
}
