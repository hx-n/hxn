          "docs": "Adds to the value and returns it. Fails if it would overflow.",
          "kind": "mutating",
          "params": [{ "name": "amount", "type": "i32" }],
          "returns": "i32",
          "fallible": true,
          "blocking": false
        },
        {
          "name": "label",
          "kind": "method",
          "params": [{ "name": "name", "type": "str" }],
          "returns": "str",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "sum",
          "kind": "method",
          "params": [{ "name": "data", "type": "bytes" }],
          "returns": "i32",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "is_positive",
          "kind": "method",
          "params": [],
          "returns": "bool",
          "fallible": false,
          "blocking": false
        },
        {
          "name": "scaled",
          "kind": "method",
          "params": [{ "name": "factor", "type": "f64" }],
          "returns": "f64",
          "fallible": false,
